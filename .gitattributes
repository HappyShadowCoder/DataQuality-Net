# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you always want to be normalized
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.csv text eol=lf

# Declare files that are always binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pt binary
*.pth binary
*.pkl binary
